# Copy to ".env" and fill in. Real environment variables override this file.
# NEVER commit the real .env.

# REQUIRED. Signs the login tokens; anyone who knows it can forge tokens.
# Generate one with:  openssl rand -hex 32
TOKEN_SECRET=

# REQUIRED: at least one AI provider key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# auto (default: Gemini if its key is set, else Claude) | gemini | anthropic
PROVIDER=auto

PORT=8080

# ---- Limits (per anonymous install, unless noted) ----
CHAT_PER_MINUTE=20
CHAT_PER_DAY=400
VISION_PER_MINUTE=8
VISION_PER_DAY=60
REGISTER_PER_HOUR=10          # sign-ups per IP address per hour
TOKEN_TTL_DAYS=30

# The wallet guard: total AI calls per UTC day across ALL users.
# Set it to what you are willing to pay for on a bad day.
DAILY_REQUEST_CAP=5000
MAX_CONCURRENT=40

# How many reverse proxies / load balancers sit in front of the server.
# 0 = none (local). 1 = e.g. Google Cloud Run. Wrong values let clients fake
# their IP address, so set this correctly when you deploy.
TRUSTED_PROXY_HOPS=0
