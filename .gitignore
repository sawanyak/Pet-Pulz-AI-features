# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Secrets: never commit real API keys, tokens or signing files.
# `.env.*` catches variants such as .env.local and .env.production; the
# template .env.example IS committed on purpose.
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx
*.mobileprovision
google-services.json
GoogleService-Info.plist
*service-account*.json

# Personal tool settings (permissions that only apply to your machine)
.claude/settings.local.json

# Committed ON PURPOSE (do not add these to the list above):
#  - pubspec.lock in the app root and in backend/, so builds use the same
#    package versions every time
#  - ios/Podfile.lock, for the same reason
#  - .env.example files, the templates for the .env files
